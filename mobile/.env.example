# Copy to .env.local (gitignored). The same Supabase project and public anon
# key as the web app's NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where shared links and password-reset emails point. Defaults to https://hevydrinkr.com.
# EXPO_PUBLIC_SITE_URL=https://hevydrinkr.com

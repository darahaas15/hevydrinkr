{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      // The web app's shared modules (../src/lib, stores, types, hooks).
      "@/*": ["../src/*"],
      // This app's own modules.
      "~/*": ["./src/*"],
      // Mirror metro.config.js: web-only packages map to their RN builds...
      "lucide-react": ["./node_modules/lucide-react-native"],
      // (Tabler publishes its types only via "exports", which path mappings
      // don't read, so point at the declaration file.)
      "@tabler/icons-react": ["./node_modules/@tabler/icons-react-native/dist/tabler-icons-react-native.d.ts"],
      "@tabler/icons-react-native": ["./node_modules/@tabler/icons-react-native/dist/tabler-icons-react-native.d.ts"],
      // ...and every other package, including those imported by the shared
      // web files, resolves from this app's node_modules, never the web app's.
      "*": ["./node_modules/@types/*", "./node_modules/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
